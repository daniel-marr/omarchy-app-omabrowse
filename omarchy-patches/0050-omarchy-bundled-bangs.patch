+void BangManager::DoStartBundledLoad() {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&ReadBundledBangs),
+        base::BindOnce(&BangManager::OnBundledLoadComplete,
+                       weak_ptr_factory_.GetWeakPtr()));
+}
+
+void BangManager::OnBundledLoadComplete(std::string manifest) {
+    if (manifest.empty()) {
+        LOG(ERROR) << "Bundled bang list is missing or empty";
+    } else {
+        LoadManifestFromString(manifest);
+    }
+
+    load_pending_ = false;
+    RunCallbacks();
+}
+
+void BangManager::RunCallbacks() {
+    if (!callbacks_.empty()) {
