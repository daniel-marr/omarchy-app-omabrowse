+// Owns one FilePathWatcher. Lives on the watcher sequence, so the watcher is
+// created and destroyed there. |on_change| runs on that sequence too.
+class ThemeWatch {
+ public:
+  using OnChange = base::RepeatingCallback<void(bool error)>;
+
+  ThemeWatch(const base::FilePath& path,
+             base::FilePathWatcher::Type type,
+             OnChange on_change)
+      : on_change_(std::move(on_change)) {
+    if (!watcher_.Watch(path, type,
+                        base::BindRepeating(&ThemeWatch::OnEvent,
+                                            base::Unretained(this)))) {
+      LOG(WARNING) << "omarchy: could not watch " << path;
+    }
+  }
+
+ private:
+  void OnEvent(const base::FilePath&, bool error) {
+    on_change_.Run(error);
+  }
+
+  base::FilePathWatcher watcher_;
+  OnChange on_change_;
+};
