+
+void OmarchyTheme::StartWatching() {
+  scoped_refptr<base::SequencedTaskRunner> ui_task_runner =
+      base::SequencedTaskRunner::GetCurrentDefault();
+  scoped_refptr<base::SequencedTaskRunner> watch_task_runner =
+      base::ThreadPool::CreateSequencedTaskRunner({base::MayBlock()});
+
+  // Runs on the watcher sequence. Hop to the UI thread before touching state.
+  ThemeWatch::OnChange on_change = base::BindRepeating(
+      [](scoped_refptr<base::SequencedTaskRunner> ui,
+         base::WeakPtr<OmarchyTheme> theme, bool error) {
+        ui->PostTask(FROM_HERE,
+                     base::BindOnce(&OmarchyTheme::OnWatchEvent, theme, error));
+      },
+      ui_task_runner, weak_factory_.GetWeakPtr());
+
+  // The current directory is watched recursively: a theme switch replaces the
+  // `theme` directory itself, so only its parent sees the change.
+  theme_watch_ = base::SequenceBound<ThemeWatch>(
+      watch_task_runner, paths_.current_dir,
+      base::FilePathWatcher::Type::kRecursive, on_change);
+  user_watch_ = base::SequenceBound<ThemeWatch>(
+      watch_task_runner, paths_.user_lua,
+      base::FilePathWatcher::Type::kNonRecursive, on_change);
+}
+
+void OmarchyTheme::OnWatchEvent(bool error) {
+  if (error) {
+    // The platform watcher stopped. Reload once now, so the state stays
+    // current, but further changes will not be seen until restart.
+    LOG(WARNING) << "omarchy: theme watcher reported an error";
+  }
+  debounce_timer_.Start(FROM_HERE, kReloadDebounce,
+                        base::BindOnce(&OmarchyTheme::Reload,
+                                       base::Unretained(this)));
 }
 
