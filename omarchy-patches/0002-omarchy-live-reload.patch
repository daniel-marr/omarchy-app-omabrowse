+TEST_F(OmarchyThemeTest, ReloadsWhenThemeFileChanges) {
+  OmarchyTheme theme(paths_);
+  CountingObserver observer;
+  theme.AddObserver(&observer);
+  theme.StartWatching();
+
+  // The watch is set up on a background sequence, so an early write can be
+  // missed. Keep writing new content until one lands after the watch starts.
+  int generation = 0;
+  EXPECT_TRUE(base::test::RunUntil([&] {
+    Write(paths_.theme_dir.Append("colors.toml"),
+          ("background = \"#1e1e2e\"\nvalue = \"" +
+           std::to_string(++generation) + "\"\n")
+              .c_str());
+    return observer.count() > 0;
+  }));
+  EXPECT_TRUE(theme.has_theme());
+  theme.RemoveObserver(&observer);
+}
+
+TEST_F(OmarchyThemeTest, BurstOfChangesReloadsOnce) {
+  Write(paths_.theme_dir.Append("colors.toml"),
+        "background = \"#1e1e2e\"\n");
+  OmarchyTheme theme(paths_);
+  CountingObserver observer;
+  theme.AddObserver(&observer);
+  theme.StartWatching();
+
+  // Let the initial watch settle, then make several quick edits. The debounce
+  // should coalesce them into a single reload, so one notification.
+  EXPECT_TRUE(base::test::RunUntil([&] {
+    Write(paths_.theme_dir.Append("colors.toml"),
+          "background = \"#1e1e2e\"\n");
+    return observer.count() > 0;
+  }));
+  int before = observer.count();
+  for (int i = 0; i < 5; ++i) {
+    Write(paths_.user_lua, ("rounding = " + std::to_string(i) + "\n").c_str());
+  }
+  EXPECT_TRUE(base::test::RunUntil([&] { return observer.count() > before; }));
+  EXPECT_EQ(observer.count(), before + 1);
+  theme.RemoveObserver(&observer);
+}
