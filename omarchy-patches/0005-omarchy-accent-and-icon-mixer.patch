+void OmarchyThemeSupplier::AddColorMixers(ui::ColorProvider* provider,
+                                          const ui::ColorProviderKey& key) const {
+  CustomThemeSupplier::AddColorMixers(provider, key);
+
+  // Added after the base mixer, so these win for the same colour IDs.
+  ui::ColorMixer& mixer = provider->AddMixer();
+  if (accent_) {
+    // Material primary drives the focus ring and other accent surfaces.
+    mixer[ui::kColorSysPrimary] = {*accent_};
+    mixer[ui::kColorFocusableBorderFocused] = {*accent_};
+  }
+  if (foreground_) {
+    // Most icons derive from these, so the whole UI icon set follows the theme.
+    mixer[ui::kColorSysOnSurface] = {*foreground_};
+    mixer[kColorToolbarButtonIcon] = {*foreground_};
+  }
+}
 
