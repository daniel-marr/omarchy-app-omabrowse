+
+// Corner radii follow the active Omarchy theme. Stock values are used when no
+// Omarchy theme is present, so the browser looks the same as before.
+int ChromeLayoutProvider::GetCornerRadiusMetric(views::Emphasis emphasis,
+                                                const gfx::Size& size) const {
+  omarchy::OmarchyTheme* theme = omarchy::OmarchyTheme::GetInstance();
+  if (!theme->has_theme()) {
+    return views::LayoutProvider::GetCornerRadiusMetric(emphasis, size);
+  }
+  const int radius = theme->radius();
+  const int half = std::min(size.width(), size.height()) / 2;
+  switch (emphasis) {
+    case views::Emphasis::kNone:
+      return 0;
+    case views::Emphasis::kLow:
+    case views::Emphasis::kMedium:
+      return radius / 2;
+    case views::Emphasis::kHigh:
+      return radius;
+    case views::Emphasis::kMaximum:
+      // An unsized request has no pill limit, so it takes the full radius.
+      return size.IsEmpty() ? radius : std::min(radius, half);
+  }
+}
+
+int ChromeLayoutProvider::GetCornerRadiusMetric(views::ShapeContextTokens token,
+                                                const gfx::Size& size) const {
+  const int stock = views::LayoutProvider::GetCornerRadiusMetric(token, size);
+  omarchy::OmarchyTheme* theme = omarchy::OmarchyTheme::GetInstance();
+  if (!theme->has_theme()) {
+    return stock;
+  }
+  const int radius = theme->radius();
+  const int half = std::min(size.width(), size.height()) / 2;
+  if (!size.IsEmpty() && half > 0 && stock == half) {
+    // A pill-shaped control: follow the theme, but never exceed the pill.
+    return std::min(radius, half);
+  }
+  // Other stock sizes are designed for a 24 px large radius. Scale them to the
+  // theme, so a 24 px theme leaves them unchanged and a 0 px theme makes them
+  // square.
+  return stock * radius / omarchy::kMaxRadius;
 }
 
