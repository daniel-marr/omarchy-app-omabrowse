 SidePanelHeader::~SidePanelHeader() = default;
 
+void SidePanelHeader::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  // With an Omarchy theme the header takes the side panel card colour, so it
+  // reads as the top of the panel rather than part of the toolbar. The
+  // corners follow the frame radius, which the theme can change live.
+  if (omarchy::OmarchyTheme::GetInstance()->has_theme()) {
+    const float radius = GetGenericFrameRadius();
+    SetBackground(views::CreateRoundedRectBackground(
+        kColorSidePanelCardBackground,
+        gfx::RoundedCornersF(radius, radius, 0, 0)));
+  } else {
+    SetBackground(nullptr);
+  }
+}
