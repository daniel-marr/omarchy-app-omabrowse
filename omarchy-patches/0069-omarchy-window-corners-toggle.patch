+TEST_F(OmarchyThemeTest, CornerToggleOverridesUserAndTheme) {
+  Write(paths_.theme_lua, "rounding = 6\n");
+  Write(paths_.user_lua, "rounding = 12\n");
+  ASSERT_TRUE(base::CreateDirectory(paths_.toggles_dir));
+  Write(paths_.toggles_dir.Append("corners-sharp.lua"),
+        "hl.config({ decoration = { rounding = 0 } })\n");
+
+  OmarchyTheme theme(paths_);
+  Reload(theme);
+  EXPECT_EQ(theme.radius(), 0);
+
+  // "Rounded" replaces "sharp"; "theme" removes both.
+  ASSERT_TRUE(base::DeleteFile(paths_.toggles_dir.Append("corners-sharp.lua")));
+  Write(paths_.toggles_dir.Append("corners-rounded.lua"),
+        "hl.config({ decoration = { rounding = 6, rounding_power = 3 } })\n");
+  Reload(theme);
+  EXPECT_EQ(theme.radius(), 6);
+
+  ASSERT_TRUE(
+      base::DeleteFile(paths_.toggles_dir.Append("corners-rounded.lua")));
+  Reload(theme);
+  EXPECT_EQ(theme.radius(), 12);
+}
+
+TEST_F(OmarchyThemeTest, SharpToggleWinsWhenBothTogglesExist) {
+  // Hyprland loads the toggles in name order, so sharp is applied last.
+  ASSERT_TRUE(base::CreateDirectory(paths_.toggles_dir));
+  Write(paths_.toggles_dir.Append("corners-rounded.lua"), "rounding = 6\n");
+  Write(paths_.toggles_dir.Append("corners-sharp.lua"), "rounding = 0\n");
+
+  OmarchyTheme theme(paths_);
+  Reload(theme);
+  EXPECT_EQ(theme.radius(), 0);
+}
+
+TEST_F(OmarchyThemeTest, ReloadsWhenCornerToggleChanges) {
+  Write(paths_.theme_dir.Append("colors.toml"), "mode = \"dark\"\n");
+  OmarchyTheme theme(paths_);
+  Reload(theme);
+  theme.StartWatching();
+  task_environment_.RunUntilIdle();
+  ASSERT_EQ(theme.radius(), 0);
+
+  // The toggles directory does not exist until the first toggle is set. As
+  // in ReloadsWhenThemeFileChanges, keep writing until a write lands after
+  // the watch is up.
+  ASSERT_TRUE(base::CreateDirectory(paths_.toggles_dir));
+  int generation = 0;
+  EXPECT_TRUE(base::test::RunUntil([&] {
+    Write(paths_.toggles_dir.Append("corners-rounded.lua"),
+          ("-- " + std::to_string(++generation) + "\nrounding = 6\n").c_str());
+    return theme.radius() == 6;
+  }));
+}
