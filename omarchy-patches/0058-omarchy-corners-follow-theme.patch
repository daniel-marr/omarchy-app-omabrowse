+TEST_F(OmarchyThemeTest, CornersFollowThemeRoundingUnlessForced) {
+  Write(paths_.theme_dir.Append("colors.toml"),
+        "mode = \"dark\"\nbackground = \"#1e1e2e\"\n");
+
+  OmarchyTheme theme(paths_);
+  Reload(theme);
+
+  // A theme with Omarchy's default rounding of 0 squares the corners.
+  EXPECT_TRUE(theme.has_theme());
+  EXPECT_TRUE(theme.corners_squared());
+
+  theme.SetForceRounded(true);
+  EXPECT_FALSE(theme.corners_squared());
+  theme.SetForceRounded(false);
+  EXPECT_TRUE(theme.corners_squared());
+
+  Write(paths_.user_lua, "rounding = 8\n");
+  Reload(theme);
+  EXPECT_EQ(theme.radius(), 8);
+  EXPECT_FALSE(theme.corners_squared());
 }
 
