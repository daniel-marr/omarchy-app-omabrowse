+
+float ChromeLayoutProvider::GetFocusRingCornerRadiusMetric(float stock) const {
+  omarchy::OmarchyTheme* theme = omarchy::OmarchyTheme::GetInstance();
+  if (!theme->has_theme()) {
+    return stock;
+  }
+  // The ring hugs the control, so it can never be rounder than a third of the
+  // theme radius. A 0 px theme gives a square ring.
+  return std::min(stock, static_cast<float>(theme->radius()) / 3.0f);
 }
 
