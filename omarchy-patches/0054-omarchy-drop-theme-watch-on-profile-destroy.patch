+void OmarchyThemeBridge::OnProfileWillBeDestroyed(Profile* profile) {
+  // Chromium destroys a regular profile when its last window closes while the
+  // browser keeps running. Its ThemeService is shut down with it, so a watch
+  // left in the map would trip the keyed-service use-after-destroy check on
+  // the next theme change.
+  profile_observations_.RemoveObservation(profile);
+  watches_.erase(profile);
+}
