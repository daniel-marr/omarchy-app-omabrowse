       LayoutConstant::kVerticalTabStripUncollapsedVerticalPadding);
+  // With an Omarchy theme the strip sits flush under the toolbar, so keep a
+  // small fixed gap above the first tab. Rounded pills read one DIP tighter
+  // than square ones, so give them one more.
+  constexpr int kTopGap = 4;
+  const int corner_radius =
+      GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius);
   int top_padding = 0;
+  if (omarchy::OmarchyTheme::GetInstance()->has_theme()) {
+    top_padding = corner_radius == 0 ? kTopGap : kTopGap + 1;
+  }
   BrowserView* const browser = browser_view();
   if (browser && browser->IsZenModeEnabledForLayout()) {
     const float top_chrome_ratio = browser->GetTopChromeRevealRatio();
@@ -897,8 +913,9 @@
