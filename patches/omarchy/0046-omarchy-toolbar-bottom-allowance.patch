+void ToolbarView::OnPaint(gfx::Canvas* canvas) {
+  views::AccessiblePaneView::OnPaint(canvas);
+  // At fractional scale factors the toolbar's bottom edge can land mid-pixel;
+  // the row below is then painted by nobody and shows the wallpaper. The
+  // layout grants a 2 DP bottom paint allowance for exactly this, so own one
+  // extra DIP in the toolbar colour. Views placed below draw over it.
+  if (omarchy::OmarchyTheme::GetInstance()->has_theme()) {
+    canvas->FillRect(gfx::Rect(0, height(), width(), 1),
+                     GetColorProvider()->GetColor(kColorToolbar));
+  }
+}
