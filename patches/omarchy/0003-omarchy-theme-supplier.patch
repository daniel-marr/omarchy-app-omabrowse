+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_OMARCHY_OMARCHY_THEME_BRIDGE_H_
+#define CHROME_BROWSER_OMARCHY_OMARCHY_THEME_BRIDGE_H_
+
+#include <map>
+#include <memory>
+
+#include "base/scoped_observation.h"
+#include "chrome/browser/omarchy/omarchy_theme.h"
+#include "chrome/browser/profiles/profile_manager_observer.h"
+
+class Profile;
+class ProfileManager;
+
+namespace omarchy {
+
+class ProfileThemeWatch;
+
+// Applies the Omarchy palette to every regular profile. It re-applies on theme
+// changes and whenever a profile's own theme settings replace the palette.
+class OmarchyThemeBridge : public OmarchyTheme::Observer,
+                           public ProfileManagerObserver {
+ public:
+  explicit OmarchyThemeBridge(ProfileManager* profile_manager);
+  OmarchyThemeBridge(const OmarchyThemeBridge&) = delete;
+  OmarchyThemeBridge& operator=(const OmarchyThemeBridge&) = delete;
+  ~OmarchyThemeBridge() override;
+
+  // OmarchyTheme::Observer:
+  void OnOmarchyThemeChanged() override;
+
+  // ProfileManagerObserver:
+  void OnProfileAdded(Profile* profile) override;
+  void OnProfileManagerDestroying() override;
+
+ private:
+  base::ScopedObservation<ProfileManager, ProfileManagerObserver>
+      profile_manager_observation_{this};
+  // Keyed by profile pointer. Entries are replaced, never looked up, so a
+  // reused address cannot collide with a stale entry.
+  std::map<Profile*, std::unique_ptr<ProfileThemeWatch>> watches_;
+};
+
+// Starts the bridge for the browser process. Call once, with the browser's
+// profile manager, before profiles load.
+void StartThemeBridge(ProfileManager* profile_manager);
+
+}  // namespace omarchy
+
+#endif  // CHROME_BROWSER_OMARCHY_OMARCHY_THEME_BRIDGE_H_
diff --git a/chrome/browser/omarchy/omarchy_theme_bridge.cc b/chrome/browser/omarchy/omarchy_theme_bridge.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/omarchy/omarchy_theme_bridge.cc
@@ -0,0 +1,112 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/omarchy/omarchy_theme_bridge.h"
+
+#include <utility>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/ref_counted.h"
+#include "base/no_destructor.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/omarchy/omarchy_theme_supplier.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/profiles/profile_observer.h"
+#include "chrome/browser/themes/theme_service.h"
+#include "chrome/browser/themes/theme_service_factory.h"
+#include "chrome/browser/themes/theme_service_observer.h"
+
+namespace omarchy {
+namespace {
+
+using ThemeType = ui::ColorProviderKey::ThemeInitializerSupplier::ThemeType;
+
+}  // namespace
+
+// Keeps one profile's theme service on the Omarchy palette. Lives as long as
+// the profile: both observations are dropped when the profile is destroyed.
+class ProfileThemeWatch : public ThemeServiceObserver, public ProfileObserver {
+ public:
+  explicit ProfileThemeWatch(Profile* profile) : profile_(profile) {
+    profile_observation_.Observe(profile_);
+  }
+  ProfileThemeWatch(const ProfileThemeWatch&) = delete;
+  ProfileThemeWatch& operator=(const ProfileThemeWatch&) = delete;
+  ~ProfileThemeWatch() override = default;
+
+  // Installs the palette if one is available.
+  void Apply() {
+    OmarchyTheme* theme = OmarchyTheme::GetInstance();
+    if (!theme->has_theme()) {
+      return;
+    }
+    ThemeService* service = ThemeServiceFactory::GetForProfile(profile_);
+    if (!theme_observation_.IsObserving()) {
+      theme_observation_.Observe(service);
+    }
+    service->SetCustomDefaultTheme(
+        base::MakeRefCounted<OmarchyThemeSupplier>(theme->colors()));
+  }
+
+  // ThemeServiceObserver:
+  void OnThemeChanged() override {
+    // Applying the palette itself notifies again. Stop once it is in place,
+    // so this cannot loop.
+    ThemeService* service = ThemeServiceFactory::GetForProfile(profile_);
+    CustomThemeSupplier* supplier = service->GetThemeSupplier();
+    if (supplier && supplier->get_theme_type() == ThemeType::kOmarchy) {
+      return;
+    }
+    Apply();
+  }
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile*) override {
+    theme_observation_.Reset();
+    profile_observation_.Reset();
+  }
+
+ private:
+  raw_ptr<Profile> profile_;
+  base::ScopedObservation<ThemeService, ThemeServiceObserver>
+      theme_observation_{this};
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+};
+
+OmarchyThemeBridge::OmarchyThemeBridge(ProfileManager* profile_manager) {
+  profile_manager_observation_.Observe(profile_manager);
+  OmarchyTheme::GetInstance()->AddObserver(this);
+  for (Profile* profile : profile_manager->GetLoadedProfiles()) {
+    OnProfileAdded(profile);
+  }
+}
+
+OmarchyThemeBridge::~OmarchyThemeBridge() {
+  OmarchyTheme::GetInstance()->RemoveObserver(this);
+}
+
+void OmarchyThemeBridge::OnOmarchyThemeChanged() {
+  for (auto& [profile, watch] : watches_) {
+    watch->Apply();
+  }
+}
+
+void OmarchyThemeBridge::OnProfileAdded(Profile* profile) {
+  if (!profile->IsRegularProfile()) {
+    return;
+  }
+  watches_[profile] = std::make_unique<ProfileThemeWatch>(profile);
+  watches_[profile]->Apply();
+}
+
+void OmarchyThemeBridge::OnProfileManagerDestroying() {
+  profile_manager_observation_.Reset();
+}
+
+void StartThemeBridge(ProfileManager* profile_manager) {
+  static base::NoDestructor<OmarchyThemeBridge> bridge(profile_manager);
+}
+
+}  // namespace omarchy
