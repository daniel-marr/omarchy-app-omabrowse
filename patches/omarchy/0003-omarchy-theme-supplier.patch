+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/omarchy/omarchy_theme_supplier.h"
+
+#include "base/memory/scoped_refptr.h"
+#include "chrome/browser/themes/theme_properties.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace omarchy {
+namespace {
+
+TEST(OmarchyThemeSupplierTest, MapsPaletteToThemeProperties) {
+  ThemeColors theme;
+  theme.colors = {{"dark_background", 0x161622}, {"background", 0x1e1e2e}};
+
+  scoped_refptr<OmarchyThemeSupplier> supplier =
+      base::MakeRefCounted<OmarchyThemeSupplier>(theme);
+
+  SkColor color = 0;
+  ASSERT_TRUE(supplier->GetColor(ThemeProperties::COLOR_FRAME_ACTIVE, &color));
+  EXPECT_EQ(color, SkColorSetRGB(0x16, 0x16, 0x22));
+  ASSERT_TRUE(supplier->GetColor(ThemeProperties::COLOR_TOOLBAR, &color));
+  EXPECT_EQ(color, SkColorSetRGB(0x1e, 0x1e, 0x2e));
+}
+
+TEST(OmarchyThemeSupplierTest, MissingKeysFallBackToBrowserDefaults) {
+  ThemeColors theme;
+  theme.colors = {{"background", 0x1e1e2e}};
+
+  scoped_refptr<OmarchyThemeSupplier> supplier =
+      base::MakeRefCounted<OmarchyThemeSupplier>(theme);
+
+  // The accent is absent, so no colour is supplied for the NTP link.
+  SkColor color = 0;
+  EXPECT_FALSE(supplier->GetColor(ThemeProperties::COLOR_NTP_LINK, &color));
+}
+
+TEST(OmarchyThemeSupplierTest, ReportsOwnThemeType) {
+  scoped_refptr<OmarchyThemeSupplier> supplier =
+      base::MakeRefCounted<OmarchyThemeSupplier>(ThemeColors{});
+  EXPECT_EQ(supplier->get_theme_type(),
+            ui::ColorProviderKey::ThemeInitializerSupplier::ThemeType::kOmarchy);
+}
+
+TEST(OmarchyThemeSupplierTest, MappingTableIsPopulated) {
+  size_t count = 0;
+  const ColorMapping* mappings = GetColorMappings(&count);
+  EXPECT_GT(count, 0u);
+  EXPECT_NE(mappings, nullptr);
+}
+
+}  // namespace
+}  // namespace omarchy
