+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_OMARCHY_OMARCHY_THEME_SUPPLIER_H_
+#define CHROME_BROWSER_OMARCHY_OMARCHY_THEME_SUPPLIER_H_
+
+#include <map>
+
+#include "chrome/browser/omarchy/omarchy_theme_parse.h"
+#include "chrome/browser/themes/custom_theme_supplier.h"
+
+namespace omarchy {
+
+// One entry of the mapping from an Omarchy colors.toml key to the browser
+// theme property it fills. Keys follow helium-theme-gen, so the browser shows
+// the same colours the generated extension used to.
+struct ColorMapping {
+  const char* key;
+  int property;  // A ThemeProperties::OverwritableColor value.
+};
+
+// The table used by OmarchyThemeSupplier. Exposed for tests.
+const ColorMapping* GetColorMappings(size_t* count);
+
+// Supplies Omarchy's palette to a profile's ThemeService in memory. Nothing is
+// written to the profile's preferences, so no theme is left bound after the
+// browser is removed.
+class OmarchyThemeSupplier : public CustomThemeSupplier {
+ public:
+  explicit OmarchyThemeSupplier(const ThemeColors& theme);
+  OmarchyThemeSupplier(const OmarchyThemeSupplier&) = delete;
+  OmarchyThemeSupplier& operator=(const OmarchyThemeSupplier&) = delete;
+
+  // CustomThemeSupplier:
+  bool GetColor(int id, SkColor* color) const override;
+
+ private:
+  ~OmarchyThemeSupplier() override;
+
+  // Theme property ID to colour. Properties without a palette entry are
+  // absent, so the browser falls back to its own defaults for them.
+  std::map<int, SkColor> colors_;
+};
+
+}  // namespace omarchy
+
+#endif  // CHROME_BROWSER_OMARCHY_OMARCHY_THEME_SUPPLIER_H_
diff --git a/chrome/browser/omarchy/omarchy_theme_supplier.cc b/chrome/browser/omarchy/omarchy_theme_supplier.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/omarchy/omarchy_theme_supplier.cc
@@ -0,0 +1,76 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/omarchy/omarchy_theme_supplier.h"
+
+#include <cstddef>
+#include <iterator>
+
+#include "chrome/browser/themes/theme_properties.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace omarchy {
+namespace {
+
+using ThemeType = ui::ColorProviderKey::ThemeInitializerSupplier::ThemeType;
+
+constexpr ColorMapping kMappings[] = {
+    {"dark_background", ThemeProperties::COLOR_FRAME_ACTIVE},
+    {"dark_background", ThemeProperties::COLOR_FRAME_ACTIVE_INCOGNITO},
+    {"dark_background", ThemeProperties::COLOR_NTP_HEADER},
+    {"darker_background", ThemeProperties::COLOR_FRAME_INACTIVE},
+    {"darker_background", ThemeProperties::COLOR_FRAME_INACTIVE_INCOGNITO},
+    {"background", ThemeProperties::COLOR_TOOLBAR},
+    {"background", ThemeProperties::COLOR_NTP_BACKGROUND},
+    {"foreground", ThemeProperties::COLOR_TOOLBAR_TEXT},
+    {"foreground", ThemeProperties::COLOR_TOOLBAR_BUTTON_ICON},
+    {"foreground", ThemeProperties::COLOR_BOOKMARK_TEXT},
+    {"foreground", ThemeProperties::COLOR_NTP_TEXT},
+    {"bright_foreground", ThemeProperties::COLOR_TAB_FOREGROUND_ACTIVE_FRAME_ACTIVE},
+    {"bright_foreground", ThemeProperties::COLOR_OMNIBOX_TEXT},
+    {"dark_foreground",
+     ThemeProperties::COLOR_TAB_FOREGROUND_INACTIVE_FRAME_ACTIVE},
+    {"dark_foreground",
+     ThemeProperties::COLOR_TAB_FOREGROUND_INACTIVE_FRAME_ACTIVE_INCOGNITO},
+    {"dark_foreground",
+     ThemeProperties::COLOR_TAB_FOREGROUND_INACTIVE_FRAME_INACTIVE},
+    {"dark_foreground",
+     ThemeProperties::COLOR_TAB_FOREGROUND_INACTIVE_FRAME_INACTIVE_INCOGNITO},
+    {"lighter_background", ThemeProperties::COLOR_OMNIBOX_BACKGROUND},
+    {"lighter_background", ThemeProperties::COLOR_CONTROL_BUTTON_BACKGROUND},
+    {"accent", ThemeProperties::COLOR_NTP_LINK},
+};
+
+}  // namespace
+
+const ColorMapping* GetColorMappings(size_t* count) {
+  *count = std::size(kMappings);
+  return kMappings;
+}
+
+OmarchyThemeSupplier::OmarchyThemeSupplier(const ThemeColors& theme)
+    : CustomThemeSupplier(ThemeType::kOmarchy) {
+  for (const ColorMapping& mapping : kMappings) {
+    auto it = theme.colors.find(mapping.key);
+    if (it == theme.colors.end()) {
+      continue;
+    }
+    uint32_t rgb = it->second;
+    colors_[mapping.property] =
+        SkColorSetRGB((rgb >> 16) & 0xff, (rgb >> 8) & 0xff, rgb & 0xff);
+  }
+}
+
+OmarchyThemeSupplier::~OmarchyThemeSupplier() = default;
+
+bool OmarchyThemeSupplier::GetColor(int id, SkColor* color) const {
+  auto it = colors_.find(id);
+  if (it == colors_.end()) {
+    return false;
+  }
+  *color = it->second;
+  return true;
+}
+
+}  // namespace omarchy
diff --git a/chrome/browser/omarchy/omarchy_theme_bridge.h b/chrome/browser/omarchy/omarchy_theme_bridge.h
new file mode 100644
