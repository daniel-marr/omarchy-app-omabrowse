+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_OMARCHY_OMARCHY_THEME_PARSE_H_
+#define CHROME_BROWSER_OMARCHY_OMARCHY_THEME_PARSE_H_
+
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace omarchy {
+
+// Largest corner radius the browser will use, in px. Mods above this are
+// clamped so a bad value cannot break the layout.
+inline constexpr int kMaxRadius = 24;
+
+// Parsed contents of an Omarchy theme's colors.toml. Colours are 0xRRGGBB.
+struct ThemeColors {
+  std::map<std::string, uint32_t> colors;
+  bool dark = true;
+};
+
+// Parses `key = "#rrggbb"` lines and `mode = "dark" | "light"`. Lines that do
+// not parse are skipped. Returns nullopt only when no colour was read at all.
+std::optional<ThemeColors> ParseColorsToml(std::string_view contents);
+
+// Finds the last uncommented `rounding = N` inside a Lua config. Returns
+// nullopt when the file does not set one. The value is clamped to
+// [0, kMaxRadius].
+std::optional<int> ParseRoundingLua(std::string_view contents);
+
+// Parses a `#rrggbb` string. Returns nullopt for any other shape.
+std::optional<uint32_t> ParseHexColor(std::string_view text);
+
+}  // namespace omarchy
+
+#endif  // CHROME_BROWSER_OMARCHY_OMARCHY_THEME_PARSE_H_
