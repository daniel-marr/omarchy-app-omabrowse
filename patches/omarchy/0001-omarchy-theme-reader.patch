+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/omarchy/omarchy_theme_parse.h"
+
+#include <algorithm>
+#include <cctype>
+#include <vector>
+
+namespace omarchy {
+namespace {
+
+std::string_view Trim(std::string_view s) {
+  while (!s.empty() && std::isspace(static_cast<unsigned char>(s.front()))) {
+    s.remove_prefix(1);
+  }
+  while (!s.empty() && std::isspace(static_cast<unsigned char>(s.back()))) {
+    s.remove_suffix(1);
+  }
+  return s;
+}
+
+// Splits `contents` into lines without the trailing newline.
+std::vector<std::string_view> SplitLines(std::string_view contents) {
+  std::vector<std::string_view> lines;
+  while (!contents.empty()) {
+    size_t end = contents.find('\n');
+    std::string_view line = contents.substr(0, end);
+    if (!line.empty() && line.back() == '\r') {
+      line.remove_suffix(1);
+    }
+    lines.push_back(line);
+    if (end == std::string_view::npos) {
+      break;
+    }
+    contents.remove_prefix(end + 1);
+  }
+  return lines;
+}
+
+// Returns the value of `key = value` with surrounding quotes removed, or
+// nullopt when the line is not an assignment to `key`.
+std::optional<std::string_view> ParseAssignment(std::string_view line,
+                                                std::string_view key) {
+  line = Trim(line);
+  if (line.substr(0, key.size()) != key) {
+    return std::nullopt;
+  }
+  std::string_view rest = Trim(line.substr(key.size()));
+  if (rest.empty() || rest.front() != '=') {
+    return std::nullopt;
+  }
+  rest = Trim(rest.substr(1));
+  if (rest.size() >= 2 && (rest.front() == '"' || rest.front() == '\'') &&
+      rest.back() == rest.front()) {
+    rest = rest.substr(1, rest.size() - 2);
+  }
+  return rest;
+}
+
+}  // namespace
+
+std::optional<uint32_t> ParseHexColor(std::string_view text) {
+  if (text.size() != 7 || text.front() != '#') {
+    return std::nullopt;
+  }
+  uint32_t value = 0;
+  for (char c : text.substr(1)) {
+    value <<= 4;
+    if (c >= '0' && c <= '9') {
+      value |= static_cast<uint32_t>(c - '0');
+    } else if (c >= 'a' && c <= 'f') {
+      value |= static_cast<uint32_t>(c - 'a' + 10);
+    } else if (c >= 'A' && c <= 'F') {
+      value |= static_cast<uint32_t>(c - 'A' + 10);
+    } else {
+      return std::nullopt;
+    }
+  }
+  return value;
+}
+
+std::optional<ThemeColors> ParseColorsToml(std::string_view contents) {
+  ThemeColors result;
+  for (std::string_view line : SplitLines(contents)) {
+    line = Trim(line);
+    if (line.empty() || line.front() == '#' || line.front() == '[') {
+      continue;
+    }
+    size_t equals = line.find('=');
+    if (equals == std::string_view::npos) {
+      continue;
+    }
+    std::string_view key = Trim(line.substr(0, equals));
+    std::optional<std::string_view> value = ParseAssignment(line, key);
+    if (!value) {
+      continue;
+    }
+    if (key == "mode") {
+      result.dark = *value != "light";
+      continue;
+    }
+    std::optional<uint32_t> color = ParseHexColor(*value);
+    if (color) {
+      result.colors[std::string(key)] = *color;
+    }
+  }
+  if (result.colors.empty()) {
+    return std::nullopt;
+  }
+  return result;
+}
+
+std::optional<int> ParseRoundingLua(std::string_view contents) {
+  std::optional<int> radius;
+  for (std::string_view line : SplitLines(contents)) {
+    // Drop Lua comments so a commented-out setting is ignored.
+    size_t comment = line.find("--");
+    if (comment != std::string_view::npos) {
+      line = line.substr(0, comment);
+    }
+    line = Trim(line);
+    constexpr std::string_view kKey = "rounding";
+    size_t pos = line.find(kKey);
+    if (pos == std::string_view::npos) {
+      continue;
+    }
+    // Require a word boundary so `rounding_power` does not match.
+    size_t after = pos + kKey.size();
+    if (after < line.size() &&
+        (std::isalnum(static_cast<unsigned char>(line[after])) ||
+         line[after] == '_')) {
+      continue;
+    }
+    std::string_view rest = Trim(line.substr(after));
+    if (rest.empty() || rest.front() != '=') {
+      continue;
+    }
+    rest = Trim(rest.substr(1));
+    // Accept an optional trailing comma, as in `rounding = 6,`.
+    if (!rest.empty() && rest.back() == ',') {
+      rest = Trim(rest.substr(0, rest.size() - 1));
+    }
+    if (rest.empty() ||
+        !std::all_of(rest.begin(), rest.end(), [](char c) {
+          return std::isdigit(static_cast<unsigned char>(c));
+        }) ||
+        rest.size() > 4) {
+      continue;
+    }
+    int value = 0;
+    for (char c : rest) {
+      value = value * 10 + (c - '0');
+    }
+    radius = std::clamp(value, 0, kMaxRadius);
+  }
+  return radius;
+}
+
+}  // namespace omarchy
diff --git a/chrome/browser/omarchy/omarchy_theme_unittest.cc b/chrome/browser/omarchy/omarchy_theme_unittest.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/omarchy/omarchy_theme_unittest.cc
@@ -0,0 +1,136 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/omarchy/omarchy_theme.h"
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/test/task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace omarchy {
+namespace {
+
+class CountingObserver : public OmarchyTheme::Observer {
+ public:
+  void OnOmarchyThemeChanged() override { ++count_; }
+  int count() const { return count_; }
+
+ private:
+  int count_ = 0;
+};
+
+class OmarchyThemeTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(home_.CreateUniqueTempDir());
+    paths_ = OmarchyTheme::Paths::ForHome(home_.GetPath());
+    ASSERT_TRUE(base::CreateDirectory(paths_.theme_dir));
+    ASSERT_TRUE(base::CreateDirectory(paths_.user_lua.DirName()));
+  }
+
+  void Write(const base::FilePath& path, const char* contents) {
+    ASSERT_TRUE(base::WriteFile(path, contents));
+  }
+
+  // Reloads and waits for the background read and its reply.
+  void Reload(OmarchyTheme& theme) {
+    theme.Reload();
+    task_environment_.RunUntilIdle();
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  base::ScopedTempDir home_;
+  OmarchyTheme::Paths paths_;
+};
+
+TEST_F(OmarchyThemeTest, LoadsPaletteAndRadiusFromTheme) {
+  Write(paths_.theme_dir.Append("colors.toml"),
+        "mode = \"dark\"\nbackground = \"#1e1e2e\"\n");
+  Write(paths_.theme_lua, "hl.config({ decoration = { rounding = 6 } })\n");
+
+  OmarchyTheme theme(paths_);
+  Reload(theme);
+
+  EXPECT_TRUE(theme.has_theme());
+  EXPECT_TRUE(theme.colors().dark);
+  EXPECT_EQ(theme.colors().colors.at("background"), 0x1e1e2eu);
+  EXPECT_EQ(theme.radius(), 6);
+}
+
+TEST_F(OmarchyThemeTest, LightThemeIsReported) {
+  Write(paths_.theme_dir.Append("colors.toml"),
+        "mode = \"light\"\nbackground = \"#f4f1e8\"\n");
+
+  OmarchyTheme theme(paths_);
+  Reload(theme);
+
+  EXPECT_TRUE(theme.has_theme());
+  EXPECT_FALSE(theme.colors().dark);
+}
+
+TEST_F(OmarchyThemeTest, MissingFilesMeanStockBehaviour) {
+  OmarchyTheme theme(paths_);
+  Reload(theme);
+
+  EXPECT_FALSE(theme.has_theme());
+  EXPECT_EQ(theme.radius(), 0);
+}
+
+TEST_F(OmarchyThemeTest, UserLooknfeelOverridesThemeRadius) {
+  Write(paths_.theme_lua, "rounding = 6\n");
+  Write(paths_.user_lua, "rounding = 12\n");
+
+  OmarchyTheme theme(paths_);
+  Reload(theme);
+
+  EXPECT_EQ(theme.radius(), 12);
+}
+
+TEST_F(OmarchyThemeTest, RadiusIsClampedToMaximum) {
+  Write(paths_.user_lua, "rounding = 500\n");
+
+  OmarchyTheme theme(paths_);
+  Reload(theme);
+
+  EXPECT_EQ(theme.radius(), kMaxRadius);
+}
+
+TEST_F(OmarchyThemeTest, MalformedColoursKeepPreviousPalette) {
+  Write(paths_.theme_dir.Append("colors.toml"),
+        "background = \"#1e1e2e\"\n");
+  OmarchyTheme theme(paths_);
+  Reload(theme);
+  ASSERT_TRUE(theme.has_theme());
+
+  Write(paths_.theme_dir.Append("colors.toml"), "background = \"#zz\"\n");
+  Reload(theme);
+
+  EXPECT_TRUE(theme.has_theme());
+  EXPECT_EQ(theme.colors().colors.at("background"), 0x1e1e2eu);
+}
+
+TEST_F(OmarchyThemeTest, ObserversNotifiedOnlyOnChange) {
+  Write(paths_.theme_dir.Append("colors.toml"),
+        "background = \"#1e1e2e\"\n");
+  OmarchyTheme theme(paths_);
+  CountingObserver observer;
+  theme.AddObserver(&observer);
+
+  Reload(theme);
+  EXPECT_EQ(observer.count(), 1);
+
+  // Same files again: nothing changed, so no notification.
+  Reload(theme);
+  EXPECT_EQ(observer.count(), 1);
+
+  Write(paths_.user_lua, "rounding = 8\n");
+  Reload(theme);
+  EXPECT_EQ(observer.count(), 2);
+
+  theme.RemoveObserver(&observer);
+}
+
+}  // namespace
+}  // namespace omarchy
