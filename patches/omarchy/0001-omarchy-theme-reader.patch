+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_OMARCHY_OMARCHY_THEME_H_
+#define CHROME_BROWSER_OMARCHY_OMARCHY_THEME_H_
+
+#include <optional>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "chrome/browser/omarchy/omarchy_theme_parse.h"
+
+namespace omarchy {
+
+// The active Omarchy theme as Helium sees it: its palette and corner radius.
+// Reads files from Omarchy's state and config directories. Nothing is written
+// to a profile, so removing the browser also removes the theme.
+class OmarchyTheme {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // Called on the UI thread after a reload changed the palette or radius.
+    virtual void OnOmarchyThemeChanged() = 0;
+  };
+
+  // Paths are injectable for tests. Use the defaults in production.
+  struct Paths {
+    base::FilePath theme_dir;     // ~/.local/state/omarchy/current/theme
+    base::FilePath theme_lua;     // theme_dir/hyprland.lua
+    base::FilePath user_lua;      // ~/.config/hypr/looknfeel.lua
+    static Paths ForHome(const base::FilePath& home);
+  };
+
+  // Shared instance for the browser process, using the real home directory.
+  static OmarchyTheme* GetInstance();
+
+  // Test constructor. Does not read anything until Reload() is called.
+  explicit OmarchyTheme(Paths paths);
+  OmarchyTheme(const OmarchyTheme&) = delete;
+  OmarchyTheme& operator=(const OmarchyTheme&) = delete;
+  ~OmarchyTheme();
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // Re-reads the files on a background task. Observers are notified on the UI
+  // thread when the result differs from the current state.
+  void Reload();
+
+  // True once a colours file has parsed. Until then Helium behaves like stock.
+  bool has_theme() const { return has_theme_; }
+  const ThemeColors& colors() const { return colors_; }
+  // Corner radius in px, always in [0, kMaxRadius]. 0 is Omarchy's default.
+  int radius() const { return radius_; }
+
+ private:
+  struct Loaded {
+    std::optional<ThemeColors> colors;
+    std::optional<int> radius;
+  };
+
+  static Loaded ReadFromDisk(Paths paths);
+  void OnLoaded(Loaded loaded);
+
+  Paths paths_;
+  bool has_theme_ = false;
+  ThemeColors colors_;
+  int radius_ = 0;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<OmarchyTheme> weak_factory_{this};
+};
+
+}  // namespace omarchy
+
+#endif  // CHROME_BROWSER_OMARCHY_OMARCHY_THEME_H_
diff --git a/chrome/browser/omarchy/omarchy_theme.cc b/chrome/browser/omarchy/omarchy_theme.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/omarchy/omarchy_theme.cc
@@ -0,0 +1,121 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/omarchy/omarchy_theme.h"
+
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/base_paths.h"
+#include "base/task/thread_pool.h"
+
+namespace omarchy {
+namespace {
+
+// Omarchy's own file, read the same way as helium-theme-gen. The file is
+// missing on machines without Omarchy, so a read failure is not an error.
+std::optional<std::string> ReadOptional(const base::FilePath& path) {
+  std::string contents;
+  if (!base::ReadFileToString(path, &contents)) {
+    return std::nullopt;
+  }
+  return contents;
+}
+
+}  // namespace
+
+OmarchyTheme::Paths OmarchyTheme::Paths::ForHome(const base::FilePath& home) {
+  Paths paths;
+  paths.theme_dir =
+      home.Append(".local/state/omarchy/current/theme");
+  paths.theme_lua = paths.theme_dir.Append("hyprland.lua");
+  paths.user_lua = home.Append(".config/hypr/looknfeel.lua");
+  return paths;
+}
+
+// static
+OmarchyTheme* OmarchyTheme::GetInstance() {
+  static base::NoDestructor<OmarchyTheme> instance([] {
+    base::FilePath home;
+    base::PathService::Get(base::DIR_HOME, &home);
+    return Paths::ForHome(home);
+  }());
+  return instance.get();
+}
+
+OmarchyTheme::OmarchyTheme(Paths paths) : paths_(std::move(paths)) {}
+
+OmarchyTheme::~OmarchyTheme() = default;
+
+void OmarchyTheme::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void OmarchyTheme::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void OmarchyTheme::Reload() {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&OmarchyTheme::ReadFromDisk, paths_),
+      base::BindOnce(&OmarchyTheme::OnLoaded, weak_factory_.GetWeakPtr()));
+}
+
+// static
+OmarchyTheme::Loaded OmarchyTheme::ReadFromDisk(Paths paths) {
+  Loaded loaded;
+
+  if (std::optional<std::string> toml =
+          ReadOptional(paths.theme_dir.Append("colors.toml"))) {
+    loaded.colors = ParseColorsToml(*toml);
+    if (!loaded.colors) {
+      LOG(WARNING) << "omarchy: colors.toml is empty or malformed; "
+                      "keeping the previous palette";
+    }
+  }
+
+  // Hyprland loads the theme file before the user's looknfeel, so the user
+  // file wins when both set a radius.
+  if (std::optional<std::string> user = ReadOptional(paths.user_lua)) {
+    loaded.radius = ParseRoundingLua(*user);
+  }
+  if (!loaded.radius) {
+    if (std::optional<std::string> theme = ReadOptional(paths.theme_lua)) {
+      loaded.radius = ParseRoundingLua(*theme);
+    }
+  }
+  return loaded;
+}
+
+void OmarchyTheme::OnLoaded(Loaded loaded) {
+  bool changed = false;
+
+  if (loaded.colors) {
+    if (!has_theme_ || loaded.colors->colors != colors_.colors ||
+        loaded.colors->dark != colors_.dark) {
+      colors_ = std::move(*loaded.colors);
+      has_theme_ = true;
+      changed = true;
+    }
+  }
+
+  // No radius in any file means Omarchy's default of 0.
+  int radius = loaded.radius.value_or(0);
+  if (radius != radius_) {
+    radius_ = radius;
+    changed = true;
+  }
+
+  if (changed) {
+    for (Observer& observer : observers_) {
+      observer.OnOmarchyThemeChanged();
+    }
+  }
+}
+
+}  // namespace omarchy
